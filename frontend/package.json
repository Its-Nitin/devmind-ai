{
  "name": "devmind-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:types": "openapi-typescript ../backend/openapi.json -o src/app/core/api/schema.d.ts && prettier --write src/app/core/api/schema.d.ts"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@primeuix/themes": "^3.1.1",
    "primeicons": "^8.0.2",
    "primeng": "^22.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.4.2",
    "jsdom": "^30.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
