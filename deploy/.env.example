# Copy to deploy/.env (git-ignored) and replace the values (SEC-6). compose.yaml refuses to start without them.

# Password for the devmind Postgres role. The database volume keeps it: changing it later means resetting the volume.
DB_PASSWORD=change-me-db-password

# Password for demo@devmind.local, seeded by the demo profile. 12 to 72 characters.
DEVMIND_SEED_PASSWORD=change-me-demo-password

# Only if a hosted chat provider is configured. v1 runs on local Ollama only (ADR-0006), so leave it unset.
# DEVMIND_LLM_API_KEY=
