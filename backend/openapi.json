        "tags" : [ "Auth" ]
      }
    },
    "/api/auth/login" : {
      "post" : {
        "description" : "Sets the session cookie and rotates the XSRF-TOKEN cookie. Needs a CSRF token from GET /api/auth/csrf first.",
        "operationId" : "logIn",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
