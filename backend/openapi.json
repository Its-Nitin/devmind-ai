{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Session-authenticated JSON API of DevMind AI. Errors are RFC 9457 problem details.",
    "title" : "DevMind API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/auth/csrf" : {
      "get" : {
        "operationId" : "issueCsrfToken",
        "responses" : {
          "204" : {
            "description" : "No Content"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unexpected error (code: internal-error)"
          }
        },
        "security" : [ ],
        "summary" : "Issue the XSRF-TOKEN cookie",
        "tags" : [ "Auth" ]
      }
    },
    "/api/auth/login" : {
      "post" : {
        "description" : "Sets the session cookie and rotates the XSRF-TOKEN cookie. Needs a CSRF token from GET /api/auth/csrf first.",
        "operationId" : "logIn",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            },
            "description" : "Signed in"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Invalid request (code: validation-failed lists the fields in errors)"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Email or password is incorrect (code: invalid-credentials)"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "CSRF token missing or invalid (code: invalid-csrf-token)"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unexpected error (code: internal-error)"
          }
        },
        "security" : [ {
          "csrf" : [ ]
        } ],
        "summary" : "Start a session",
        "tags" : [ "Auth" ]
      }
    },
    "/api/auth/logout" : {
      "post" : {
        "description" : "Invalidates the session and clears the XSRF-TOKEN cookie. Signed-out callers get 204 too.",
        "operationId" : "logOut",
        "responses" : {
          "204" : {
            "description" : "Signed out"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "CSRF token missing or invalid (code: invalid-csrf-token)"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unexpected error (code: internal-error)"
          }
        },
        "security" : [ {
          "csrf" : [ ]
        } ],
        "summary" : "End the session",
        "tags" : [ "Auth" ]
      }
    },
    "/api/auth/me" : {
      "get" : {
        "operationId" : "getCurrentUser",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            },
            "description" : "OK"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not signed in (code: unauthenticated)"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unexpected error (code: internal-error)"
          }
        },
        "security" : [ {
          "session" : [ ]
        } ],
        "summary" : "The signed-in user",
        "tags" : [ "Auth" ]
      }
    },
    "/api/projects" : {
      "get" : {
        "operationId" : "listProjects",
        "parameters" : [ {
          "description" : "Zero-based page index",
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0,
            "minimum" : 0
          }
        }, {
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20,
            "maximum" : 100,
            "minimum" : 1
          }
        }, {
          "description" : "`name` or `createdAt`, optionally followed by `,asc` or `,desc`",
          "in" : "query",
          "name" : "sort",
          "required" : false,
          "schema" : {
            "type" : "string",
            "default" : "createdAt,desc",
            "pattern" : "^(name|createdAt)(,(asc|desc))?$"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PagedModelProjectResponse"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Invalid request (code: validation-failed lists the fields in errors)"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not signed in (code: unauthenticated)"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unexpected error (code: internal-error)"
          }
        },
        "security" : [ {
          "session" : [ ]
        } ],
        "summary" : "List your projects",
        "tags" : [ "Projects" ]
      },
      "post" : {
        "operationId" : "createProject",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateProjectRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProjectResponse"
                }
              }
            },
            "description" : "Created",
            "headers" : {
              "Location" : {
                "description" : "Path of the new project",
                "schema" : {
                  "type" : "string",
                  "format" : "uri-reference"
                },
                "style" : "simple"
              }
            }
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Invalid request (code: validation-failed lists the fields in errors)"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not signed in (code: unauthenticated)"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "CSRF token missing or invalid (code: invalid-csrf-token)"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "You already have a project with this name (code: project-name-taken)"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unexpected error (code: internal-error)"
          }
        },
        "security" : [ {
          "csrf" : [ ],
          "session" : [ ]
        } ],
        "summary" : "Register a project",
        "tags" : [ "Projects" ]
      }
    },
    "/api/projects/{projectId}" : {
      "delete" : {
        "operationId" : "deleteProject",
        "parameters" : [ {
          "in" : "path",
          "name" : "projectId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Invalid request (code: validation-failed lists the fields in errors)"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not signed in (code: unauthenticated)"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "CSRF token missing or invalid (code: invalid-csrf-token)"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not found, or not yours (code: <resource>-not-found)"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unexpected error (code: internal-error)"
          }
        },
        "security" : [ {
          "csrf" : [ ],
          "session" : [ ]
        } ],
        "summary" : "Delete one of your projects",
        "tags" : [ "Projects" ]
      },
      "get" : {
        "operationId" : "getProject",
        "parameters" : [ {
          "in" : "path",
          "name" : "projectId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProjectResponse"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Invalid request (code: validation-failed lists the fields in errors)"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not signed in (code: unauthenticated)"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Not found, or not yours (code: <resource>-not-found)"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Unexpected error (code: internal-error)"
          }
        },
        "security" : [ {
          "session" : [ ]
        } ],
        "summary" : "Get one of your projects",
        "tags" : [ "Projects" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "CreateProjectRequest" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "sourceLocation" : {
            "type" : "string",
            "maxLength" : 500,
            "minLength" : 0
          },
          "sourceType" : {
            "type" : "string",
            "enum" : [ "LOCAL", "GIT_PUBLIC" ]
          }
        },
        "required" : [ "name", "sourceLocation", "sourceType" ]
      },
      "FieldViolation" : {
        "type" : "object",
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "required" : [ "field", "message" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 72,
            "minLength" : 0
          }
        },
        "required" : [ "email", "password" ]
      },
      "PageMetadata" : {
        "type" : "object",
        "properties" : {
          "number" : {
            "type" : "integer",
            "format" : "int64"
          },
          "size" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "number", "size", "totalElements", "totalPages" ]
      },
      "PagedModelProjectResponse" : {
        "type" : "object",
        "properties" : {
          "content" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ProjectResponse"
            }
          },
          "page" : {
            "$ref" : "#/components/schemas/PageMetadata"
          }
        },
        "required" : [ "content", "page" ]
      },
      "Problem" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "correlationId" : {
            "type" : [ "string", "null" ]
          },
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "type" : [ "array", "null" ],
            "items" : {
              "$ref" : "#/components/schemas/FieldViolation"
            }
          },
          "instance" : {
            "type" : [ "string", "null" ],
            "format" : "uri"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          }
        },
        "required" : [ "code", "detail", "status", "title", "type" ]
      },
      "ProjectResponse" : {
        "type" : "object",
        "properties" : {
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "defaultBranch" : {
            "type" : [ "string", "null" ]
          },
          "name" : {
            "type" : "string"
          },
          "projectId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "sourceLocation" : {
            "type" : "string"
          },
          "sourceType" : {
            "type" : "string",
            "enum" : [ "LOCAL", "GIT_PUBLIC" ]
          }
        },
        "required" : [ "createdAt", "name", "projectId", "sourceLocation", "sourceType" ]
      },
      "UserResponse" : {
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "userId" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "displayName", "email", "userId" ]
      }
    },
    "securitySchemes" : {
      "csrf" : {
        "description" : "The XSRF-TOKEN cookie's value, echoed on every unsafe request. GET /api/auth/csrf issues the cookie.",
        "in" : "header",
        "name" : "X-XSRF-TOKEN",
        "type" : "apiKey"
      },
      "session" : {
        "description" : "HttpOnly session cookie set by POST /api/auth/login. Browsers send it automatically.",
        "in" : "cookie",
        "name" : "JSESSIONID",
        "type" : "apiKey"
      }
    }
  }
}
