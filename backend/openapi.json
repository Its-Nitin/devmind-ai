    "/api/projects/{projectId}/revisions/{sha}/file" : {
      "get" : {
        "description" : "At most 2000 lines per call; read longer files in ranges.",
        "operationId" : "readFile",
        "parameters" : [ {
          "in" : "path",
          "name" : "projectId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "in" : "path",
          "name" : "sha",
          "required" : true,
          "schema" : {
            "type" : "string",
            "pattern" : "^[0-9a-f]{7,40}$"
          }
        }, {
          "description" : "File path, e.g. src/main/java/App.java",
          "in" : "query",
          "name" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "maxLength" : 1000,
            "minLength" : 0
          }
        }, {
          "description" : "First line, 1-based; default 1",
          "in" : "query",
          "name" : "from",
          "required" : false,
          "schema" : {
            "type" : [ "integer", "null" ],
            "format" : "int32",
            "minimum" : 1
          }
        }, {
          "description" : "Last line, inclusive; default the end, within the per-call limit",
          "in" : "query",
          "name" : "to",
          "required" : false,
          "schema" : {
            "type" : [ "integer", "null" ],
            "format" : "int32",
            "minimum" : 1
          }
        } ],
        "responses" : {
